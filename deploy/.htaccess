# ── Apache variantas (Netlify šio failo nenaudoja — jam yra netlify.toml) ──
# Prototipas neturi patekti į Google
Header set X-Robots-Tag "noindex, nofollow, noarchive"

# Slaptažodis. Įjungti nuėmus # ir sugeneravus .htpasswd:
#   htpasswd -c /kelias/iki/.htpasswd klientas
# AuthType Basic
# AuthName "BUHALTERIJOS DEMO - dizaino prototipas"
# AuthUserFile /absoliutus/kelias/iki/.htpasswd
# Require valid-user

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
